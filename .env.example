# Copy to .env.local (or .env) for local dev. Both are git-ignored.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Answers: Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings: Gemini (Groq has no embeddings API). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low          # low | medium | high
# GROQ_MAX_TOKENS=4096
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# ALLOW_ORIGIN=
# PORT=3000
