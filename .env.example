# Copy to .env.local (or .env) for local dev. Both are git-ignored.
# On Vercel, set these under Project → Settings → Environment Variables instead.
# Get a key at https://aistudio.google.com/apikey and restrict it to the Gemini API.
GEMINI_API_KEY=

# Optional (defaults shown). GOOGLE_API_KEY is also accepted and takes precedence if both are set.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_VERSION=v1beta
# GEMINI_API_REVISION=2026-05-20
# GEMINI_THINKING_LEVEL=low
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# ALLOW_ORIGIN=
# PORT=3000
